{
  "task": "observatory-v3",
  "mode": "full",
  "schema_version": "1.0",
  "steps": [
    {
      "id": "step-1",
      "skill": "roster-implement",
      "inputs": [
        "briefs/observatory-v3-plan.md",
        "briefs/observatory-v3-implementer.md",
        "briefs/observatory-v3-spec.md",
        "roster/observatory-v3/context.manifest.json"
      ],
      "outputs": [
        "briefs/observatory-v3-impl.md",
        "briefs/observatory-v3-manifest.txt",
        "roster/observatory-v3/evidence/"
      ],
      "hook": false
    },
    {
      "id": "step-2",
      "skill": "roster-review",
      "inputs": [
        "briefs/observatory-v3-impl.md",
        "briefs/observatory-v3-reviewer.md",
        "briefs/observatory-v3-manifest.txt",
        "roster/observatory-v3/evidence/"
      ],
      "outputs": [
        "briefs/observatory-v3-review.json",
        "briefs/observatory-v3-review-trace.jsonl"
      ],
      "hook": false
    },
    {
      "id": "step-3",
      "skill": "roster-qa",
      "inputs": [
        "briefs/observatory-v3-review.json",
        "briefs/observatory-v3-qa-scope.md",
        "briefs/observatory-v3-impl.md",
        "roster/observatory-v3/evidence/"
      ],
      "outputs": [
        "briefs/observatory-v3-qa.md",
        "briefs/observatory-v3-qa-state.json"
      ],
      "hook": false
    }
  ],
  "quality_gates": {
    "build": "rtk npm run build",
    "test": "rtk npm test",
    "lint": ""
  }
}
