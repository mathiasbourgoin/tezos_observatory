      },
      {
        "name": "typescript-patterns",
        "source": "roster",
        "scope": "project",
        "category": "language"
      }
    ],
    "hooks": [
      {
        "name": "block-dangerous-commands",
        "event": "PreToolUse",
        "matcher": "Bash",
        "source": "roster"
      },
      {
        "name": "enforce-file-manifest",
        "event": "PreToolUse",
